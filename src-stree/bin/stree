#!/usr/bin/env php
<?php

declare(strict_types=1);

/** @psalm-suppress MixedAssignment */
$autoload = $GLOBALS['_composer_autoload_path']
    ?? (static function (): string {
        // Standalone package: src-stree/vendor; monorepo: repository-root vendor.
        foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../vendor/autoload.php'] as $candidate) {
            if (file_exists($candidate)) {
                return $candidate;
            }
        }

        return __DIR__ . '/../../vendor/autoload.php';
    })();

if (! is_string($autoload) || ! is_readable($autoload)) {
    fwrite(STDERR, "stree: Composer autoloader not found. Run 'composer install' first.\n");
    exit(1);
}

/** @psalm-suppress UnresolvableInclude */
require_once $autoload;

use Koriym\SemanticLogger\Stree\StreeCommand;

$command = new StreeCommand();
$exitCode = $command($argv);
exit($exitCode);
